#!/bin/bash

# Image to run. Override with PACSIFIER_DOCKER_IMAGE; the version line below is
# stamped automatically at release time (see .releaserc.json).
PACSIFIER_VERSION="1.1.0"
PACSIFIER_DOCKER_IMAGE="${PACSIFIER_DOCKER_IMAGE:-quay.io/translationalml/pacsifier:${PACSIFIER_VERSION}}"

DATA_PATH=""
EXTRA_ARGS=()

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -d|--data_folder)
      DATA_PATH="$2"
      shift 2
      ;;
    *)
      EXTRA_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$DATA_PATH" ]]; then
  echo "Error: Missing required arguments. Ensure you provide -d (data folder)."
  exit 1
fi

echo "Running: sudo docker run --rm --net=host -v $DATA_PATH:/data ${PACSIFIER_DOCKER_IMAGE} pacsifier-extract-carestream-report ${EXTRA_ARGS[*]}"

sudo docker run --rm --net=host --user "$(id -u):$(id -g)" \
  -v "$DATA_PATH:/data" \
  ${PACSIFIER_DOCKER_IMAGE} pacsifier-extract-carestream-report "${EXTRA_ARGS[@]}"
