#!/bin/bash

# Extract file paths from the arguments
CONFIG_PATH=""
QUERY_PATH=""
OUTPUT_PATH=""
EXTRA_ARGS=()

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -c|--config)
      CONFIG_PATH="$2"
      shift 2
      ;;
    -q|--queryfile)
      QUERY_PATH="$2"
      shift 2
      ;;
    -d|--out_directory)
      OUTPUT_PATH="$2"
      shift 2
      ;;
    *)
      EXTRA_ARGS+=("$1") # Collect all other arguments
      shift
      ;;
  esac
done

# Ensure the required paths are provided
if [[ -z "$CONFIG_PATH" || -z "$QUERY_PATH" || -z "$OUTPUT_PATH" ]]; then
  echo "Error: Missing required arguments. Ensure you provide -c (config), -q (queryfile), and -d (out_directory)."
  exit 1
fi

# Debug: Print the Docker command being executed
echo "Running: sudo docker run --rm --net=host -v $CONFIG_PATH:/config.json -v $QUERY_PATH:/query.csv -v $OUTPUT_PATH:/output pacsifier:1.0.0 pacsifier -c /config.json -q /query.csv -d /output ${EXTRA_ARGS[*]}"

# Run the Docker command with proper volume mounts
sudo docker run --rm --net=host --user "$(id -u):$(id -g)" \
  -v "$CONFIG_PATH:/config.json" \
  -v "$QUERY_PATH:/query.csv" \
  -v "$OUTPUT_PATH:/output" \
  pacsifier:1.0.0 pacsifier \
  -c /config.json \
  -q /query.csv \
  -d /output "${EXTRA_ARGS[@]}"
