#!/bin/bash

# Image to run. Override with PACSIFIER_DOCKER_IMAGE; the version line below is
# stamped automatically at release time (see .releaserc.json).
PACSIFIER_VERSION="1.1.0"
PACSIFIER_DOCKER_IMAGE="${PACSIFIER_DOCKER_IMAGE:-quay.io/translationalml/pacsifier:${PACSIFIER_VERSION}}"

DICOM_PATH=""
INFO_PATH=""
EXTRA_ARGS=()

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -d|--dicom_folder)
      DICOM_PATH="$2"
      shift 2
      ;;
    -o|--info_folder)
      INFO_PATH="$2"
      shift 2
      ;;
    *)
      EXTRA_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$DICOM_PATH" || -z "$INFO_PATH" ]]; then
  echo "Error: Missing required arguments. Ensure you provide -d (DICOM folder) and -o (info folder)."
  exit 1
fi

echo "Running: sudo docker run --rm --net=host -v $DICOM_PATH:/dicom -v $INFO_PATH:/info ${PACSIFIER_DOCKER_IMAGE} pacsifier-move-csv ${EXTRA_ARGS[*]}"

sudo docker run --rm --net=host --user "$(id -u):$(id -g)" \
  -v "$DICOM_PATH:/dicom" \
  -v "$INFO_PATH:/info" \
  ${PACSIFIER_DOCKER_IMAGE} pacsifier-move-csv "${EXTRA_ARGS[@]}"
